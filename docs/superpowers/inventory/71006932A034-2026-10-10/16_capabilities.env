# capabilities.env — collect_inventory v2 生成（消费方: M1 采集器/控制器）
NPROC=191
HAS_CPUFREQ=no
GOVERNOR=none
CPUFREQ_DRIVER=none
HAS_TIME_IN_STATE=no
GOVERNOR_RESPONSE_VERIFIED=unknown  # R1 写入实验需用户批准后单做（v5 §7.4.1）
HAS_OEM_VOLTAGE=no  # 2026-09-24 全量探测定案: 0x30 0x91-0x98 被 0xD6 封印（v5 附录 B）
CPU_ONLINE_WRITABLE=unknown
PMU_L3C_COUNT=48
PMU_HHA_COUNT=16
PMU_DDRC_COUNT=32
EDAC_MC_COUNT=1
RASDAEMON_ACTIVE=inactive
ACPI_HAS_BERT=yes
ACPI_HAS_EINJ=yes
ACPI_HAS_HEST=yes
ACPI_HAS_ERST=yes
MEM_NODES="0 1 2 3 4 5 6 7"
PMU_CORE_COUNTERS=16  # 无复用容量实测（递增事件至首次 multiplex）
AB_BASELINE_FILE=/home/sdc/sdc-excite-reproduce/monitor/ab_baseline.json
