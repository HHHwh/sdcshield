/run-all-forever.log
/run-pid.txt
# spectrum campaign log directories (run_sdc_spectrum.sh 产物)
/sdc_spectrum_*/
# typical names for meson build directories
/build*/
# offline-build runtime artifacts (generated, not source):
#   dist/            — 现场 tarballs (package-release.sh 产物)
#   built-index.tsv  — 跨 SP 总表 (package-release.sh 每次重新生成)
dist/
/scripts/offline-build/built-index.tsv
# ctags
tags
# clangd background-index cache
/.cache/
/.vscode/
# Claude Code local artifacts (session state, agent memory);
# commands/ is project tooling and lives in-repo (self-containment)
/.claude/*
!/.claude/commands/
/memory/
# python bytecode caches (e.g. scripts/__pycache__/ after local runs)
__pycache__/
# pytest cache (rootdir is repo root, see tools/telemetry/)
.pytest_cache/
# M5 故障演练产物（drills/out/<类名>/root/ 隔离根证据——本地可再生）
/scripts/sdc-excite-reproduce/drills/out/
